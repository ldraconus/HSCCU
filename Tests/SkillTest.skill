{
    "name": "Test Skill",
    "description": "{
                      swap                                                        // skill-addr 1 (show-roll) -u-> 1 (show-roll) skill-addr
                      data Get len if { swap pop 'Test Edit: ' swap data Get + }  // if data has a length return msg + it (get rid of roll)
                                   else { swap pop '<incomplete>' }               // get rid of the roll and return '<incoomplete>'
                    }",
    "form": "{
               Label 'Test Label' Text pop
               LineEdit 'Test Edit' Prompt { } Callback edit swap Set
               data '' Set
             }",
    "roll": "{ }",
    "points": "{ 5 }",
    "restore": "{ edit Get data Get Text pop }",
    "store": "{ edit Value data swap Set }",
    "isSkill": "{ 1 }",
    "isPerk": "{ 0 }",
    "isTalent": "{ 0 }"
}
