{
    "name": "Test Skill",
    "description": "{ v Str [@] len if { 'Test Edit: ' v Str [@] + } else { '<incomplete>' } }",
    "form": "{
               Edit <var 0 <--
               Label <var 0 <--
               Layout <var -->
               Widget <var -->
               Widget @ Layout @ 'Test Label' createLabel Label -->
               Widget @ Layout @ 'Test Edit:' createLineEdit { } Edit -->
               v Str '' [<--]
             }",
    "roll": "{ '' }",
    "points": "{ 5 }",
    "restore": "{ Edit @ v Str [@] set }",
    "store": "{ v Str Edit @ get [<--] }",
    "isSkill": "{ 1 }",
    "isPerk": "{ 0 }",
    "isTalent": "{ 0 }"
}
